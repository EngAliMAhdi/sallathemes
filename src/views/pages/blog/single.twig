{% extends "layouts.master" %}

{% block content %}
{% component 'header.breadcrumbs' %}

<section class="max-w-4xl mx-auto px-4 lg:px-8 py-8 md:py-12">
    <article class="glass-card p-8 md:p-12 mb-8">
        <div class="flex items-center gap-3 mb-4">
            {% if post.author.avatar %}
                <img src="{{ post.author.avatar }}" alt="{{ post.author.name }}" class="w-10 h-10 rounded-full object-cover"/>
            {% endif %}
            <div>
                <span class="text-white text-sm font-medium">{{ post.author.name }}</span>
                <p class="text-white/25 text-xs">{{ post.published_at }}</p>
            </div>
        </div>

        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-6">{{ post.title }}</h1>

        {% if post.image %}
            <img src="{{ post.image }}" alt="{{ post.title }}" class="w-full rounded-2xl mb-8"/>
        {% endif %}

        <div class="text-white/60 leading-relaxed prose prose-invert max-w-none">
            {{ post.content|raw }}
        </div>
    </article>

    <div>
        {% component 'comments' %}
    </div>
</section>
{% endblock %}
