{% extends "layouts.master" %}

{% block content %}
{% component 'header.breadcrumbs' %}

<section class="max-w-[1400px] mx-auto px-4 lg:px-8 py-8 md:py-12">
    <div class="text-center mb-12" x-data="animateOnScroll">
        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">{{ trans('common.elements.blog') }}</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for post in posts %}
            <a href="{{ post.url }}" class="glass-card group" x-data="animateOnScroll">
                {% if post.image %}
                    <div class="aspect-video rounded-xl overflow-hidden mb-5">
                        <img src="{{ post.image }}" alt="{{ post.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
                    </div>
                {% endif %}
                <div class="p-2">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-neon-purple text-xs font-medium">{{ post.category }}</span>
                        <span class="text-white/20 text-xs">{{ post.published_at }}</span>
                    </div>
                    <h2 class="text-white font-display font-bold text-lg mb-2 group-hover:text-neon-purple transition-colors line-clamp-2">
                        {{ post.title }}
                    </h2>
                    <p class="text-white/40 text-sm line-clamp-3">{{ post.excerpt }}</p>
                </div>
            </a>
        {% endfor %}
    </div>
</section>
{% endblock %}
