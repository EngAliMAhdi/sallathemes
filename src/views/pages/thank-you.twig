{% extends "layouts.master" %}

{% block content %}
<section class="max-w-[1400px] mx-auto px-4 lg:px-8 py-16 md:py-24">
    <div class="max-w-xl mx-auto text-center">
        <div class="w-20 h-20 mx-auto mb-8 rounded-full bg-neon-green/10 border border-neon-green/20 flex items-center justify-center">
            <svg class="w-10 h-10 text-neon-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
            {{ trans('common.elements.order_confirmed') }}
        </h1>
        <p class="text-white/40 text-lg mb-8">
            {{ trans('common.elements.thank_you_message') }}
        </p>

        <div class="glass-card p-6 md:p-8 mb-8 text-left">
            <h3 class="font-display font-bold text-white text-lg mb-4">
                {{ trans('common.elements.order_details') }}
            </h3>
            <div class="space-y-3 text-sm">
                <div class="flex justify-between py-2 border-b border-white/[0.04]">
                    <span class="text-white/40">{{ trans('common.elements.order_number') }}</span>
                    <span class="text-white font-mono">{{ order.id }}</span>
                </div>
                <div class="flex justify-between py-2 border-b border-white/[0.04]">
                    <span class="text-white/40">{{ trans('common.elements.order_date') }}</span>
                    <span class="text-white">{{ order.created_at }}</span>
                </div>
                <div class="flex justify-between py-2 border-b border-white/[0.04]">
                    <span class="text-white/40">{{ trans('common.elements.payment_method') }}</span>
                    <span class="text-white">{{ order.payment_method }}</span>
                </div>
                <div class="flex justify-between py-2">
                    <span class="text-white/40">{{ trans('common.elements.total') }}</span>
                    <span class="text-white font-bold text-lg">{{ order.total|money }}</span>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="{{ link('customer.orders') }}" class="btn-primary">
                {{ trans('common.elements.track_order') }}
            </a>
            <a href="{{ link('/') }}" class="btn-outline">
                {{ trans('common.elements.continue_shopping') }}
            </a>
        </div>
    </div>
</section>
{% endblock %}
