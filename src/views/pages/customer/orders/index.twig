{% extends "layouts.master" %}

{% block content %}
<section class="max-w-[1400px] mx-auto px-4 lg:px-8 py-8 md:py-12">
    <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-8">{{ trans('common.elements.my_orders') }}</h1>

    {% if orders|length > 0 %}
        <div class="space-y-4">
            {% for order in orders %}
                <a href="{{ link('customer.orders.single', order.id) }}" class="glass-card p-4 md:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 group">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <span class="font-mono text-sm text-white/40">#{{ order.id }}</span>
                            <span class="badge badge-new text-[10px]">{{ order.status }}</span>
                        </div>
                        <p class="text-white/30 text-xs">{{ order.created_at }}</p>
                    </div>
                    <div class="text-right">
                        <span class="text-white font-bold">{{ order.total|money }}</span>
                        <p class="text-white/25 text-xs">{{ order.items_count }} {{ trans('common.elements.items') }}</p>
                    </div>
                    <svg class="w-5 h-5 text-white/20 group-hover:text-neon-purple transition-colors md:block hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-16 glass-card">
            <svg class="w-16 h-16 mx-auto mb-4 text-white/10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <h3 class="text-white/40 font-semibold mb-2">{{ trans('common.elements.no_orders') }}</h3>
            <p class="text-white/25 text-sm mb-6">{{ trans('common.elements.no_orders_desc') }}</p>
            <a href="{{ link('/') }}" class="btn-primary text-sm">{{ trans('common.elements.start_shopping') }}</a>
        </div>
    {% endif %}
</section>
{% endblock %}
