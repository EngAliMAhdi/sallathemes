{% extends "layouts.master" %}

{% block content %}
<section class="max-w-4xl mx-auto px-4 lg:px-8 py-8 md:py-12">
    <a href="{{ link('customer.orders') }}" class="flex items-center gap-2 text-white/40 hover:text-white transition-colors text-sm mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        {{ trans('common.elements.back_to_orders') }}
    </a>

    <h1 class="font-display text-3xl font-bold text-white mb-8">
        {{ trans('common.elements.order') }} #{{ order.id }}
    </h1>

    <div class="glass-card p-6 md:p-8 mb-6">
        <h3 class="font-display font-bold text-white text-lg mb-4">{{ trans('common.elements.order_details') }}</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <p class="text-white/25 text-xs mb-1">{{ trans('common.elements.status') }}</p>
                <span class="badge badge-new text-xs">{{ order.status }}</span>
            </div>
            <div>
                <p class="text-white/25 text-xs mb-1">{{ trans('common.elements.order_date') }}</p>
                <p class="text-white text-sm">{{ order.created_at }}</p>
            </div>
            <div>
                <p class="text-white/25 text-xs mb-1">{{ trans('common.elements.payment_method') }}</p>
                <p class="text-white text-sm">{{ order.payment_method }}</p>
            </div>
            <div>
                <p class="text-white/25 text-xs mb-1">{{ trans('common.elements.total') }}</p>
                <p class="text-white font-bold">{{ order.total|money }}</p>
            </div>
        </div>
    </div>

    <div class="glass-card p-6 md:p-8">
        <h3 class="font-display font-bold text-white text-lg mb-4">{{ trans('common.elements.order_items') }}</h3>
        <div class="space-y-4">
            {% for item in order.items %}
                <div class="flex items-center gap-4 py-3 border-b border-white/[0.04] last:border-0">
                    <img src="{{ item.image }}" alt="{{ item.name }}" class="w-16 h-16 rounded-xl object-cover"/>
                    <div class="flex-1">
                        <h4 class="text-white text-sm font-medium">{{ item.name }}</h4>
                        <p class="text-white/30 text-xs">{{ trans('common.elements.qty') }}: {{ item.quantity }}</p>
                    </div>
                    <span class="text-white font-semibold text-sm">{{ item.total|money }}</span>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
