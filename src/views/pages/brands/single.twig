{% extends "layouts.master" %}

{% block content %}
{% component 'header.breadcrumbs' %}

<section class="max-w-4xl mx-auto px-4 lg:px-8 py-8 md:py-12">
    <div class="text-center mb-12">
        <img src="{{ brand.logo }}" alt="{{ brand.name }}" class="w-24 h-24 object-contain mx-auto mb-4"/>
        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-2">{{ brand.name }}</h1>
        {% if brand.description %}
            <p class="text-white/40 text-lg max-w-xl mx-auto">{{ brand.description }}</p>
        {% endif %}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        {% for product in brand.products %}
            {% include 'partials.product.card' with { product: product } %}
        {% endfor %}
    </div>
</section>
{% endblock %}
