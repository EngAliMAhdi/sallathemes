{% extends "layouts.master" %}

{% block content %}
{% component 'header.breadcrumbs' %}

<section class="max-w-[1400px] mx-auto px-4 lg:px-8 py-8 md:py-12">
    <div class="text-center mb-12" x-data="animateOnScroll">
        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-4">{{ trans('common.elements.brands') }}</h1>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6">
        {% for brand in brands %}
            <a href="{{ brand.url }}" class="glass-card p-6 flex flex-col items-center justify-center text-center group min-h-[160px]">
                <img src="{{ brand.logo }}" alt="{{ brand.name }}" class="w-16 h-16 object-contain mb-4 group-hover:scale-110 transition-transform"/>
                <h3 class="text-white text-sm font-medium group-hover:text-neon-purple transition-colors">{{ brand.name }}</h3>
            </a>
        {% endfor %}
    </div>
</section>
{% endblock %}
