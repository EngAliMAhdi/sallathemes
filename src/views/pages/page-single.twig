{% extends "layouts.master" %}

{% block content %}
{% component 'header.breadcrumbs' %}

<article class="max-w-4xl mx-auto px-4 lg:px-8 py-8 md:py-12">
    <div class="glass-card p-8 md:p-12">
        <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-6">
            {{ page.title }}
        </h1>

        <div class="text-white/60 leading-relaxed prose prose-invert max-w-none">
            {{ page.content|raw }}
        </div>
    </div>

    <div class="mt-12">
        {% component 'comments' %}
    </div>
</article>
{% endblock %}
