<section class="max-w-4xl mx-auto" x-data>
    <h3 class="font-display text-xl font-bold text-white mb-6">
        {{ trans('common.elements.comments') }} ({{ comments|length }})
    </h3>

    <div class="space-y-6">
        {% for comment in comments %}
            <div class="glass-card p-6">
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-neon-purple to-purple-700 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                        {{ comment.user.name|slice(0, 1) }}
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <h4 class="text-white font-semibold text-sm">{{ comment.user.name }}</h4>
                            <span class="text-white/20 text-xs">{{ comment.created_at }}</span>
                        </div>
                        {% if comment.rating %}
                            <div class="flex text-yellow-400 text-xs mb-2">
                                {% for i in 1..5 %}
                                    <svg class="w-3 h-3 {{ i <= comment.rating ? 'fill-current' : 'text-white/15' }}" viewBox="0 0 24 24">
                                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                    </svg>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <p class="text-white/50 text-sm leading-relaxed">{{ comment.content }}</p>

                        {% if comment.replies|length > 0 %}
                            <div class="mt-4 pl-6 border-l border-white/[0.06] space-y-4">
                                {% for reply in comment.replies %}
                                    <div class="flex items-start gap-3">
                                        <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/40 text-xs font-bold flex-shrink-0">
                                            {{ reply.user.name|slice(0, 1) }}
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2 mb-0.5">
                                                <span class="text-white/70 text-sm font-medium">{{ reply.user.name }}</span>
                                                <span class="text-white/20 text-[10px]">{{ reply.created_at }}</span>
                                            </div>
                                            <p class="text-white/40 text-sm">{{ reply.content }}</p>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="mt-8 glass-card p-6">
        <h4 class="font-display font-bold text-white text-lg mb-4">{{ trans('common.elements.add_comment') }}</h4>
        <form class="space-y-4">
            <div>
                <label class="block text-sm text-white/60 mb-1.5">{{ trans('common.elements.your_rating') }}</label>
                <div class="flex gap-1" x-data="{ rating: 0 }">
                    {% for i in 1..5 %}
                        <button type="button" @click="rating = {{ i }}"
                                class="text-2xl transition-colors"
                                :class="rating >= {{ i }} ? 'text-yellow-400' : 'text-white/15 hover:text-white/30'">
                            ★
                        </button>
                    {% endfor %}
                </div>
            </div>
            <div>
                <textarea rows="4" class="glass-input w-full text-sm"
                          placeholder="{{ trans('common.elements.comment_placeholder') }}"></textarea>
            </div>
            <button type="submit" class="btn-primary text-sm">{{ trans('common.elements.submit_comment') }}</button>
        </form>
    </div>
</section>
