<section class="max-w-[1400px] mx-auto px-4 lg:px-8">
    <div class="glass-card p-8 md:p-12" x-data="animateOnScroll">
        <div class="text-center mb-8">
            <h2 class="font-display text-2xl md:text-3xl font-bold text-white mb-2">
                {{ title|default('Secure Payment Methods') }}
            </h2>
            <p class="text-white/40 text-sm">
                {{ subtitle|default('100% secure & encrypted transactions') }}
            </p>
        </div>

        <div class="flex items-center justify-center gap-4 md:gap-6">
            {% component 'footer.payment-methods' %}
        </div>

        <div class="flex justify-center gap-2 mt-6">
            <svg class="w-5 h-5 text-neon-green" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/>
            </svg>
            <span class="text-white/30 text-xs">{{ trans('common.elements.ssl_encrypted') }}</span>
        </div>
    </div>
</section>
