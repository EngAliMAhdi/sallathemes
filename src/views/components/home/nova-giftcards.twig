{# NOVA Gift Cards Section #}
<section class="s-block--nova-giftcards py-16">
    <div class="container">
        {% if component.title %}<div class="text-center mb-10"><h2 class="text-3xl md:text-4xl font-bold text-white mb-2">{{ component.title }}</h2>{% if component.subtitle %}<p class="text-white/40 text-lg">{{ component.subtitle }}</p>{% endif %}</div>{% endif %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <a href="#" class="relative rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:-translate-y-2 bg-white/[0.02] border border-white/[0.04] backdrop-blur-sm p-8 flex flex-col items-center justify-center text-center min-h-[200px] group hover:border-fuchsia-500/30 hover:shadow-[0_0_40px_rgba(180,77,255,.15)]">
                <i class="sicon-playstation text-5xl text-fuchsia-400 mb-4 group-hover:scale-110 transition-transform"></i>
                <h3 class="text-white font-bold text-lg mb-1">PlayStation</h3>
                <p class="text-white/30 text-sm">بطاقات PSN</p>
            </a>
            <a href="#" class="relative rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:-translate-y-2 bg-white/[0.02] border border-white/[0.04] backdrop-blur-sm p-8 flex flex-col items-center justify-center text-center min-h-[200px] group hover:border-green-500/30 hover:shadow-[0_0_40px_rgba(0,229,80,.15)]">
                <i class="sicon-xbox text-5xl text-green-400 mb-4 group-hover:scale-110 transition-transform"></i>
                <h3 class="text-white font-bold text-lg mb-1">Xbox</h3>
                <p class="text-white/30 text-sm">بطاقات Xbox Live</p>
            </a>
            <a href="#" class="relative rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:-translate-y-2 bg-white/[0.02] border border-white/[0.04] backdrop-blur-sm p-8 flex flex-col items-center justify-center text-center min-h-[200px] group hover:border-cyan-500/30 hover:shadow-[0_0_40px_rgba(0,229,255,.15)]">
                <i class="sicon-steam text-5xl text-cyan-400 mb-4 group-hover:scale-110 transition-transform"></i>
                <h3 class="text-white font-bold text-lg mb-1">Steam</h3>
                <p class="text-white/30 text-sm">بطاقات Steam Wallet</p>
            </a>
            <a href="#" class="relative rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:-translate-y-2 bg-white/[0.02] border border-white/[0.04] backdrop-blur-sm p-8 flex flex-col items-center justify-center text-center min-h-[200px] group hover:border-amber-500/30 hover:shadow-[0_0_40px_rgba(255,193,7,.15)]">
                <i class="sicon-google-play text-5xl text-amber-400 mb-4 group-hover:scale-110 transition-transform"></i>
                <h3 class="text-white font-bold text-lg mb-1">Google Play</h3>
                <p class="text-white/30 text-sm">بطاقات جوجل بلاي</p>
            </a>
        </div>
    </div>
</section>
