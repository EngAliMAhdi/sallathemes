<section class="relative py-20 overflow-hidden"
         style="background-color: {{ background_color|default('#0f001a') }}"
         x-data="countdown('{{ end_date }}')">
    <div class="absolute inset-0 grid-mesh opacity-30"></div>
    <div class="absolute inset-0 countdown-offer-bg"></div>

    <div class="absolute top-10 right-10 w-64 h-64 bg-neon-cyan/10 rounded-full blur-[80px] animate-pulse-neon"></div>
    <div class="absolute bottom-10 left-10 w-48 h-48 bg-neon-purple/10 rounded-full blur-[60px] animate-pulse-neon" style="animation-delay: 1s;"></div>

    <div class="relative max-w-[1400px] mx-auto px-4 lg:px-8 text-center">
        <span class="badge badge-hot mb-6 text-base px-4 py-2">{{ trans('common.elements.limited_offer') }}</span>

        <h2 class="font-display text-3xl md:text-5xl font-bold text-white mb-4" x-data="animateOnScroll">
            {{ title|default('Limited Time Mega Deal') }}
        </h2>

        <p class="text-white/50 text-lg max-w-xl mx-auto mb-10" x-data="animateOnScroll">
            {{ subtitle|default("Don't miss out on this exclusive offer") }}
        </p>

        <div x-show="!expired" class="flex justify-center gap-3 md:gap-4 mb-10">
            <div class="countdown-box">
                <span class="countdown-value" x-text="days">00</span>
                <span class="countdown-label">{{ trans('common.elements.days') }}</span>
            </div>
            <div class="countdown-box">
                <span class="countdown-value" x-text="hours">00</span>
                <span class="countdown-label">{{ trans('common.elements.hours') }}</span>
            </div>
            <div class="countdown-box">
                <span class="countdown-value" x-text="minutes">00</span>
                <span class="countdown-label">{{ trans('common.elements.minutes') }}</span>
            </div>
            <div class="countdown-box">
                <span class="countdown-value" x-text="seconds">00</span>
                <span class="countdown-label">{{ trans('common.elements.seconds') }}</span>
            </div>
        </div>

        {% if button_url and button_text %}
            <a href="{{ button_url }}" class="btn-cyan text-lg px-10 py-4 inline-block" x-data="animateOnScroll">
                {{ button_text }}
            </a>
        {% endif %}

        <div x-show="expired" class="text-center mt-6" x-data="animateOnScroll">
            <span class="badge badge-sale text-xl px-6 py-3">{{ trans('common.elements.offer_ended') }}</span>
        </div>
    </div>
</section>
