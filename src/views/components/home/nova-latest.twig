{# NOVA Latest Products #}
<section class="s-block--nova-latest py-16">
    <div class="container">
        {% if component.title %}<div class="flex items-center justify-between mb-8"><h2 class="text-2xl md:text-3xl font-bold text-white">{{ component.title }}</h2><a href="{{ link('latest') }}" class="text-purple-400 hover:text-purple-300 text-sm flex items-center gap-1 transition-colors">عرض الكل <i class="sicon-arrow-left rtl:rotate-180 text-xs"></i></a></div>{% endif %}
        <salla-products-list source="latest" limit="8"></salla-products-list>
    </div>
</section>
