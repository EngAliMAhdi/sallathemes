<section x-data="homeHero" class="relative w-full overflow-hidden">
    <div class="relative h-[60vh] md:h-[75vh] lg:h-[85vh]">
        <div class="absolute inset-0">
            <div class="absolute inset-0 bg-gradient-to-b from-surface-950/40 via-surface-950/20 to-surface-950 z-10"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-surface-950/80 via-transparent to-surface-950/80 z-10"></div>
        </div>

        <div x-ref="slides" class="relative w-full h-full">
            {% for slide in slides %}
                <div x-show="currentSlide === {{ loop.index0 }}"
                     x-transition:enter="transition ease-out duration-700"
                     x-transition:enter-start="opacity-0 scale-105"
                     x-transition:enter-end="opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-500"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95"
                     class="absolute inset-0">
                    <img src="{{ slide.image }}"
                         alt="{{ slide.title }}"
                         class="w-full h-full object-cover hidden md:block"/>
                    <img src="{{ slide.mobile_image|default(slide.image) }}"
                         alt="{{ slide.title }}"
                         class="w-full h-full object-cover md:hidden"/>
                </div>
            {% endfor %}
        </div>

        <div class="absolute inset-0 z-20 flex items-center">
            <div class="max-w-[1400px] mx-auto px-4 lg:px-8 w-full">
                <div class="max-w-xl" x-show="currentSlide === {{ loop.index0 }}" x-transition>
                    {% for slide in slides %}
                        <div x-show="currentSlide === {{ loop.index0 }}"
                             x-transition:enter="transition ease-out duration-700 delay-200"
                             x-transition:enter-start="opacity-0 translate-y-8"
                             x-transition:enter-end="opacity-100 translate-y-0">
                            {% if slide.badge_text %}
                                <span class="badge badge-new mb-4">{{ slide.badge_text }}</span>
                            {% endif %}

                            <h1 class="font-display text-4xl md:text-5xl lg:text-7xl font-bold text-white leading-none mb-4">
                                {% if slide.title %}
                                    {{ slide.title|raw }}
                                {% else %}
                                    {{ store.name }}
                                {% endif %}
                            </h1>

                            {% if slide.subtitle %}
                                <p class="text-white/50 text-lg md:text-xl leading-relaxed mb-8">
                                    {{ slide.subtitle }}
                                </p>
                            {% endif %}

                            <div class="flex flex-wrap gap-4">
                                {% if slide.button_url and slide.button_text %}
                                    <a href="{{ slide.button_url }}" class="btn-primary">
                                        {{ slide.button_text }}
                                    </a>
                                {% endif %}
                                <a href="#featured-products" class="btn-outline">
                                    {{ trans('common.elements.explore') }}
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {% if slides|length > 1 %}
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2">
            {% for slide in slides %}
                <button @click="goToSlide({{ loop.index0 }})"
                        class="w-2.5 h-2.5 rounded-full transition-all duration-300"
                        :class="currentSlide === {{ loop.index0 }} ? 'bg-neon-purple w-8' : 'bg-white/20 hover:bg-white/40'">
                </button>
            {% endfor %}
        </div>

        <button @click="prevSlide()"
                class="absolute left-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 flex items-center justify-center rounded-full bg-white/5 backdrop-blur-md border border-white/10 text-white/60 hover:text-white hover:border-neon-purple/30 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>

        <button @click="nextSlide()"
                class="absolute right-4 top-1/2 -translate-y-1/2 z-30 w-12 h-12 flex items-center justify-center rounded-full bg-white/5 backdrop-blur-md border border-white/10 text-white/60 hover:text-white hover:border-neon-purple/30 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </button>
        {% endif %}
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-surface-950 to-transparent z-20 pointer-events-none"></div>
</section>
