{# NOVA Gaming Categories #}
<section class="s-block--nova-cats py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-purple-900/5 to-transparent pointer-events-none"></div>
    <div class="container relative">
        {% if component.title %}<div class="text-center mb-10"><h2 class="text-3xl md:text-4xl font-bold text-white mb-2">{{ component.title }}</h2>{% if component.subtitle %}<p class="text-white/40 text-lg">{{ component.subtitle }}</p>{% endif %}</div>{% endif %}
        {% set cats = component.categories is defined and component.categories|length ? component.categories : store.categories|slice(0, 6) %}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            {% for cat in cats %}
                <a href="{{ cat.url }}" class="relative rounded-2xl overflow-hidden cursor-pointer transition-all duration-500 hover:-translate-y-2 bg-white/[0.02] border border-white/[0.04] backdrop-blur-sm p-6 flex flex-col items-center justify-center text-center aspect-square group hover:border-purple-500/30 hover:shadow-[0_0_40px_rgba(180,77,255,.15)]">
                    <div class="w-16 h-16 rounded-xl bg-white/[0.03] border border-white/[0.06] flex items-center justify-center mb-4 group-hover:scale-110 group-hover:border-purple-400/30 transition-all duration-300">
                        {% if cat.image %}<img src="{{ cat.image }}" alt="{{ cat.name }}" class="w-10 h-10 object-contain"/>{% else %}<i class="sicon-game-controller-alt text-2xl text-purple-400"></i>{% endif %}
                    </div>
                    <h3 class="text-white font-bold text-sm group-hover:text-purple-300 transition-colors">{{ cat.name }}</h3>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
