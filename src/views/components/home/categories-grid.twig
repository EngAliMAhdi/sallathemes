<section class="max-w-[1400px] mx-auto px-4 lg:px-8">
    <div class="text-center mb-12" x-data="animateOnScroll">
        <h2 class="section-title neon-text-purple">{{ title|default('Shop by Category') }}</h2>
        <p class="section-subtitle">{{ subtitle|default('Explore our premium collection') }}</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4 md:gap-6" x-data="animateOnScroll">
        {% for category in store.categories|slice(0, 12) %}
            <a href="{{ category.url }}" class="category-card-neon">
                <div class="category-glow"></div>
                <div class="category-bg"></div>
                <div class="category-content">
                    {% if category.image %}
                        <img src="{{ category.image }}"
                             alt="{{ category.name }}"
                             class="category-icon w-12 h-12 object-contain"/>
                    {% else %}
                        <div class="category-icon">
                            <svg class="w-12 h-12 text-neon-purple/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                      d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                            </svg>
                        </div>
                    {% endif %}
                    <h3 class="text-white text-sm md:text-base font-semibold text-center">{{ category.name }}</h3>
                    {% if category.products_count %}
                        <span class="text-white/30 text-xs mt-1">{{ category.products_count }} {{ trans('common.elements.products') }}</span>
                    {% endif %}
                </div>
            </a>
        {% endfor %}
    </div>
</section>
