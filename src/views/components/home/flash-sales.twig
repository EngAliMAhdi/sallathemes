<section class="relative py-16"
         x-data="countdown('{{ end_date }}')"
         style="background-color: {{ background_color|default('#0f001a') }}">
    <div class="absolute inset-0 grid-mesh opacity-30"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-neon-purple/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="relative max-w-[1400px] mx-auto px-4 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-10">
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-red-500/20 border border-red-500/30">
                        <svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </span>
                    <h2 class="font-display text-2xl md:text-3xl font-bold text-white">
                        {{ title|default('Flash Sales') }}
                    </h2>
                </div>
                <p class="text-white/40">{{ subtitle|default('Limited time offers!') }}</p>
            </div>

            <div x-show="!expired" class="flex gap-3">
                <div class="countdown-box">
                    <span class="countdown-value" x-text="days">00</span>
                    <span class="countdown-label">{{ trans('common.elements.days') }}</span>
                </div>
                <div class="countdown-box">
                    <span class="countdown-value" x-text="hours">00</span>
                    <span class="countdown-label">{{ trans('common.elements.hours') }}</span>
                </div>
                <div class="countdown-box">
                    <span class="countdown-value" x-text="minutes">00</span>
                    <span class="countdown-label">{{ trans('common.elements.minutes') }}</span>
                </div>
                <div class="countdown-box">
                    <span class="countdown-value" x-text="seconds">00</span>
                    <span class="countdown-label">{{ trans('common.elements.seconds') }}</span>
                </div>
            </div>

            <div x-show="expired" class="text-center">
                <span class="badge badge-sale text-base px-4 py-2">{{ trans('common.elements.offer_ended') }}</span>
            </div>
        </div>

        <div class="relative" x-data="flashSales">
            <button @click="scrollLeft()"
                    class="absolute -left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 flex items-center justify-center rounded-full bg-surface-900/80 backdrop-blur-md border border-white/10 text-white hover:text-neon-purple transition-all shadow-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>

            <div x-ref="scrollContainer"
                 class="flex gap-4 overflow-x-auto scrollbar-hide scroll-smooth pb-4 -mx-4 px-4">
                {% for product in store.featured_products|slice(0, 8) %}
                    <div class="min-w-[220px] md:min-w-[260px] flex-shrink-0">
                        {% include 'partials.product.card' with { product: product } %}
                    </div>
                {% endfor %}
            </div>

            <button @click="scrollRight()"
                    class="absolute -right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 flex items-center justify-center rounded-full bg-surface-900/80 backdrop-blur-md border border-white/10 text-white hover:text-neon-purple transition-all shadow-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>
</section>
