<ul class="flex items-center gap-2">
    {% for link in links %}
        <li>
            <a href="{{ link.url }}"
               title="{{ link.name }}"
               aria-label="{{ link.name }}"
               class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/[0.03] border border-white/[0.04] text-white/40 hover:text-neon-purple hover:border-neon-purple/30 hover:bg-neon-purple/5 transition-all">
                <i class="sicon-{{ link.type }} text-lg"></i>
            </a>
        </li>
    {% endfor %}
</ul>
