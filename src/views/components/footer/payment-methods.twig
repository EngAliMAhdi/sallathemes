<ul class="flex flex-wrap items-center gap-3">
    {% for method in payment_methods %}
        <li class="w-12 h-8 flex items-center justify-center rounded-lg bg-white/[0.03] border border-white/[0.04] p-1">
            <img src="{{ ('images/payment/'~ method ~'_mini.png') | cdn }}"
                 alt="{{ method }}"
                 class="max-w-full max-h-full object-contain opacity-60 hover:opacity-100 transition-opacity"/>
        </li>
    {% endfor %}
    {% if store.social.maroof %}
        <li class="w-12 h-8 flex items-center justify-center rounded-lg bg-white/[0.03] border border-white/[0.04] p-1">
            <a href="{{ store.social.maroof }}" target="_blank" rel="noreferrer">
                <img src="{{ 'images/maroof-footer.png' | cdn }}"
                     alt="maroof"
                     class="max-w-full max-h-full object-contain opacity-60 hover:opacity-100 transition-opacity"/>
            </a>
        </li>
    {% endif %}
</ul>
