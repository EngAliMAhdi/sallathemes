<ul class="flex items-center gap-3">
    {% for app in apps %}
        <li>
            <a href="{{ app.url }}" rel="noreferrer" target="_blank"
               class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/[0.03] border border-white/[0.04] text-white/40 hover:text-white hover:border-white/20 transition-all text-sm">
                <img src="{{ app.name }}.png"
                     alt="{{ app.name }}"
                     class="w-5 h-5 object-contain opacity-60"/>
                <span>{{ app.name }}</span>
            </a>
        </li>
    {% endfor %}
</ul>
