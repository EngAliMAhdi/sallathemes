<div class="search-overlay"
     :class="{ 'active': searchOpen }"
     x-data="smartSearch">
    <div class="w-full max-w-2xl">
        <div class="relative">
            <input type="text"
                   x-ref="input"
                   x-model="query"
                   @input="handleInput()"
                   @keydown="handleKeydown($event)"
                   @focus="focused = true"
                   @blur="focused = false"
                   placeholder="{{ trans('common.elements.search_placeholder') }}"
                   class="w-full bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl px-6 py-5 text-white text-lg placeholder-white/30 focus:outline-none focus:border-neon-purple/50 focus:ring-2 focus:ring-neon-purple/20 transition-all duration-300"/>

            <div class="absolute right-4 top-1/2 -translate-y-1/2 flex items-center gap-2">
                <div x-show="loading" class="w-5 h-5 border-2 border-neon-purple/30 border-t-neon-purple rounded-full animate-spin"></div>
                <button @click="clear()" x-show="query.length > 0"
                        class="text-white/40 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
                <kbd class="hidden sm:inline-flex items-center px-2 py-0.5 text-xs text-white/20 bg-white/5 rounded border border-white/10">
                    ESC
                </kbd>
            </div>
        </div>

        <div x-show="results.length > 0"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="mt-4 glass rounded-2xl overflow-hidden">
            <div class="p-2">
                <template x-for="item in results" :key="item.id">
                    <a :href="item.url"
                       @click="searchOpen = false"
                       class="flex items-center gap-4 p-3 rounded-xl hover:bg-white/5 transition-colors group">
                        <img :src="item.image" :alt="item.name"
                             class="w-12 h-12 rounded-lg object-cover"/>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-white group-hover:text-neon-purple transition-colors truncate"
                               x-text="item.name"></p>
                            <p class="text-xs text-white/40 mt-0.5" x-text="item.price"></p>
                        </div>
                        <svg class="w-4 h-4 text-white/20 group-hover:text-neon-purple transition-colors flex-shrink-0"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </template>
            </div>
        </div>

        <div x-show="focused && query.length >= 2 && results.length === 0 && !loading"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             class="mt-4 text-center py-8 text-white/30">
            <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <p class="text-sm">{{ trans('common.elements.no_results') }}</p>
        </div>

        <div x-show="focused && query.length < 2 && results.length === 0"
             class="mt-4">
            <div class="glass rounded-2xl p-6">
                <h4 class="text-xs font-semibold text-white/30 uppercase tracking-wider mb-3">
                    {{ trans('common.elements.popular_searches') }}
                </h4>
                <div class="flex flex-wrap gap-2">
                    {% for category in store.categories|slice(0, 6) %}
                        <a href="{{ category.url }}"
                           @click="searchOpen = false"
                           class="px-4 py-2 bg-white/[0.03] border border-white/[0.06] rounded-full text-sm text-white/50 hover:text-neon-purple hover:border-neon-purple/30 transition-all">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <button @click="searchOpen = false"
            class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center text-white/40 hover:text-white transition-colors rounded-xl hover:bg-white/5">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
</div>
