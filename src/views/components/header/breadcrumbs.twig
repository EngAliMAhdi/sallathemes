{% if breadcrumbs|length > 0 %}
<nav class="py-3 border-b border-white/[0.04]">
    <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
        <ol class="flex items-center gap-2 text-sm text-white/40 overflow-x-auto scrollbar-hide whitespace-nowrap">
            {% for breadcrumb in breadcrumbs %}
                {% if not loop.last %}
                    <li class="flex items-center gap-2">
                        <a href="{{ breadcrumb.url }}" class="hover:text-white transition-colors">
                            {{ breadcrumb.title }}
                        </a>
                        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </li>
                {% else %}
                    <li class="text-white/80 font-medium">
                        {{ breadcrumb.title|raw }}
                    </li>
                {% endif %}
            {% endfor %}
        </ol>
    </div>
</nav>
{% endif %}
