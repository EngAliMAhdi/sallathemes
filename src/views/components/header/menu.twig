{% set is_mobile = is_mobile|default(false) %}

{% if is_mobile %}
<nav class="flex flex-col gap-1">
    {% for menu in menus %}
        <div class="border-b border-white/[0.04] last:border-0">
            {% if menu.has_children %}
                <button @click="expanded = !expanded"
                        x-data="{ expanded: false }"
                        class="w-full flex items-center justify-between py-3 text-white/80 hover:text-white transition-colors text-sm font-medium">
                    <span>{{ menu.title }}</span>
                    <svg class="w-4 h-4 transition-transform duration-200"
                         :class="{ 'rotate-180': expanded }"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div x-show="expanded" x-collapse class="pl-4 pb-2 space-y-1">
                    <a href="{{ menu.url }}" class="block py-2 text-white/50 hover:text-neon-purple transition-colors text-sm">
                        {{ trans('common.elements.all') }} {{ menu.title }}
                    </a>
                    {% for submenu in menu.children %}
                        {% include 'header.menu-item' with { menu: submenu, is_root_menu: false, is_mobile: true } %}
                    {% endfor %}
                </div>
            {% else %}
                <a href="{{ menu.url }}" class="block py-3 text-white/80 hover:text-neon-purple transition-colors text-sm font-medium">
                    {{ menu.title }}
                </a>
            {% endif %}
        </div>
    {% endfor %}

    <div class="mt-6 pt-6 border-t border-white/10 space-y-2">
        <a href="{{ link('customer.profile') }}" class="flex items-center gap-3 py-2 text-white/60 hover:text-white transition-colors text-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            {{ trans('common.elements.profile') }}
        </a>
        <a href="{{ link('customer.wishlist') }}" class="flex items-center gap-3 py-2 text-white/60 hover:text-white transition-colors text-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            {{ trans('common.elements.wishlist') }}
        </a>
    </div>
</nav>
{% else %}
<nav class="flex items-center gap-1">
    {% for menu in menus %}
        {% if menu.has_children %}
            <div class="relative mega-menu-trigger">
                <a href="{{ menu.url }}"
                   class="nav-link flex items-center gap-1 px-3 py-2 {{ is_current_url(menu.url) ? 'active' : '' }}">
                    <span>{{ menu.title }}</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </a>

                <div class="mega-menu-dropdown">
                    <div class="max-w-[1400px] mx-auto px-8 py-8">
                        <div class="grid grid-cols-12 gap-8">
                            <div class="col-span-3">
                                <h4 class="font-display font-bold text-white mb-4">{{ menu.title }}</h4>
                                <ul class="space-y-2">
                                    <li>
                                        <a href="{{ menu.url }}" class="text-white/50 hover:text-neon-purple transition-colors text-sm">
                                            {{ trans('common.elements.all') }} {{ menu.title }}
                                        </a>
                                    </li>
                                    {% for submenu in menu.children %}
                                        <li>
                                            <a href="{{ submenu.url }}"
                                               class="text-white/50 hover:text-neon-purple transition-colors text-sm block py-1">
                                                {{ submenu.title }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>

                            {% if menu.mega_menu %}
                            <div class="col-span-9">
                                <div class="grid grid-cols-4 gap-4">
                                    {% for product in menu.mega_menu|slice(0, 4) %}
                                        <a href="{{ product.url }}" class="group">
                                            <div class="aspect-square rounded-xl overflow-hidden mb-3 bg-white/5">
                                                <img src="{{ product.image.url }}"
                                                     alt="{{ product.image.alt }}"
                                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                                     loading="lazy"/>
                                            </div>
                                            <h5 class="text-sm font-medium text-white/80 group-hover:text-white transition-colors truncate">
                                                {{ product.name }}
                                            </h5>
                                            <div class="mt-1">
                                                {% if product.on_sale %}
                                                    <span class="text-neon-pink font-bold text-sm">{{ product.sale_price|money }}</span>
                                                    <span class="text-white/30 line-through text-xs ml-2">{{ product.regular_price|money }}</span>
                                                {% else %}
                                                    <span class="text-white/70 text-sm">{{ product.price|money }}</span>
                                                {% endif %}
                                            </div>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <a href="{{ menu.url }}"
               class="nav-link px-3 py-2 {{ is_current_url(menu.url) ? 'active' : '' }}">
                {{ menu.title }}
            </a>
        {% endif %}
    {% endfor %}
</nav>
{% endif %}
