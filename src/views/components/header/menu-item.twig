{% set is_mobile = is_mobile|default(false) %}
{% set is_root_menu = is_root_menu|default(true) %}

{% if is_mobile %}
    {% if menu.has_children %}
        <div x-data="{ subExpanded: false }" class="pl-2">
            <button @click="subExpanded = !subExpanded"
                    class="w-full flex items-center justify-between py-2 text-white/60 hover:text-white transition-colors text-sm">
                <span>{{ menu.title }}</span>
                <svg class="w-3 h-3 transition-transform" :class="{ 'rotate-180': subExpanded }"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>
            <div x-show="subExpanded" x-collapse class="pl-3 space-y-1">
                <a href="{{ menu.url }}" class="block py-1.5 text-white/40 hover:text-neon-purple transition-colors text-xs">
                    {{ trans('common.elements.all') }}
                </a>
                {% for submenu in menu.children %}
                    <a href="{{ submenu.url }}" class="block py-1.5 text-white/50 hover:text-neon-purple transition-colors text-sm">
                        {{ submenu.title }}
                    </a>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <a href="{{ menu.url }}" class="block py-2 text-white/60 hover:text-neon-purple transition-colors text-sm">
            {{ menu.title }}
        </a>
    {% endif %}
{% else %}
    <a href="{{ menu.url }}"
       class="block px-4 py-2 text-white/50 hover:text-neon-purple hover:bg-white/[0.03] transition-all text-sm rounded-lg">
        {{ menu.title }}
    </a>
{% endif %}
