<header class="sticky-header z-50 transition-all duration-300"
        :class="{ 'header-scrolled': scrolled }"
        x-data>
    <div class="absolute inset-0 bg-surface-950/60 backdrop-blur-xl transition-all duration-300"
         :class="{ 'opacity-100': scrolled, 'opacity-0': !scrolled }"></div>

    <div class="relative">
        <div class="border-b border-white/[0.04]">
            <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
                <div class="flex items-center justify-between h-8 text-xs text-white/40">
                    <div class="hidden md:flex items-center gap-4">
                        {% component 'footer.contacts' with { is_header: true } %}
                    </div>
                    <div class="flex items-center gap-4">
                        <salla-currency-switcher></salla-currency-switcher>
                        {% if store.multilingual %}
                        <salla-language-switcher></salla-language-switcher>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-[1400px] mx-auto px-4 lg:px-8">
            <div class="flex items-center justify-between h-16 lg:h-20">
                <button @click="toggleMobileMenu()" class="lg:hidden text-white/70 hover:text-white transition-colors p-2 -ml-2">
                    <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>

                <a href="{{ link('/') }}" class="flex items-center gap-2 flex-shrink-0">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-neon-purple to-purple-700 flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <span class="font-display font-bold text-xl hidden sm:block">
                        <span class="text-white">{{ store.name[:3] }}</span><span class="text-neon-purple">{{ store.name[3:6]|default('') }}</span>
                    </span>
                </a>

                <nav class="hidden lg:flex items-center gap-1">
                    {% component 'header.menu' %}
                </nav>

                <div class="flex items-center gap-2">
                    <button @click="toggleSearch()"
                            class="w-10 h-10 flex items-center justify-center text-white/60 hover:text-white transition-colors rounded-xl hover:bg-white/5">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </button>

                    <a href="{{ link('customer.profile') }}"
                       class="w-10 h-10 flex items-center justify-center text-white/60 hover:text-white transition-colors rounded-xl hover:bg-white/5">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </a>

                    <a href="{{ link('customer.wishlist') }}"
                       class="w-10 h-10 flex items-center justify-center text-white/60 hover:text-white transition-colors rounded-xl hover:bg-white/5">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        </svg>
                    </a>

                    <a href="{{ link('cart') }}"
                       class="w-10 h-10 flex items-center justify-center text-white/60 hover:text-white transition-colors rounded-xl hover:bg-white/5 relative">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div x-show="mobileMenuOpen"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 -translate-y-2"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 -translate-y-2"
         class="lg:hidden border-t border-white/5 bg-surface-950/95 backdrop-blur-2xl">
        <div class="max-h-[calc(100vh-5rem)] overflow-y-auto px-4 py-4">
            {% component 'header.menu' with { is_mobile: true } %}
        </div>
    </div>
</header>
