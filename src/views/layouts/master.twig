<!DOCTYPE html>
<html lang="{{ store.lang }}" dir="{{ store.dir }}" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{% block title %}{{ store.name }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ store.description|striptags|slice(0, 160) }}{% endblock %}">
    <meta name="theme-color" content="#0f001a">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="{{ cdn_url }}">

    <link rel="stylesheet" href="{{ asset('app.css') }}">

    {% block head_styles %}{% endblock %}

    {{ store.header_code|raw }}
</head>
<body class="bg-surface-950 text-white font-sans antialiased min-h-screen"
      x-data="themeApp"
      x-init="init()">

    <div class="flex flex-col min-h-screen">
        {% component 'header.header' %}

        <main class="flex-1">
            {% block content %}{% endblock %}
        </main>

        {% component 'footer.footer' %}
    </div>

    {% if theme.settings.get('floating_cart') %}
    <div x-data="floatingCart"
         class="fixed bottom-6 right-6 z-50">
        <button @click="toggle()"
                class="floating-cart-btn relative">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
            </svg>
            <span x-show="count > 0"
                  x-text="count"
                  class="floating-cart-count"></span>
        </button>

        <div x-show="open"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 translate-y-4"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 translate-y-4"
             @click.outside="open = false"
             class="absolute bottom-20 right-0 w-96 max-w-[calc(100vw-2rem)] glass rounded-2xl p-6 shadow-2xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-display font-bold text-lg">{{ trans('common.elements.cart') }}</h3>
                <button @click="open = false" class="text-white/40 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <div x-show="count === 0" class="text-center py-8 text-white/40">
                <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
                </svg>
                <p>{{ trans('common.elements.empty_cart') }}</p>
            </div>

            <div x-show="count > 0" class="space-y-3">
                <template x-for="item in items" :key="item.id">
                    <div class="flex gap-3 items-center">
                        <img :src="item.image" :alt="item.name" class="w-14 h-14 rounded-lg object-cover"/>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium truncate" x-text="item.name"></p>
                            <p class="text-xs text-white/50" x-text="`${item.quantity} x ${item.price}`"></p>
                        </div>
                        <button @click="removeItem(item.id)" class="text-white/30 hover:text-red-400 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                </template>

                <div class="border-t border-white/10 pt-3 mt-3">
                    <div class="flex justify-between mb-4">
                        <span class="text-white/60">{{ trans('common.elements.total') }}</span>
                        <span class="font-bold" x-text="total"></span>
                    </div>
                    <a href="{{ link('cart') }}" class="btn-primary w-full text-center block">
                        {{ trans('common.elements.view_cart') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if theme.settings.get('smart_search_overlay') %}
    {% component 'header.search' %}
    {% endif %}

    <script src="{{ asset('app.js') }}"></script>

    {% block scripts %}{% endblock %}

    {{ store.footer_code|raw }}
</body>
</html>
