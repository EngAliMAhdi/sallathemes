{% if option.type == "color" %}
    <div class="flex flex-wrap gap-2">
        {% for value in option.values %}
            <label class="w-8 h-8 rounded-full border-2 transition-all cursor-pointer hover:scale-110"
                   style="background-color: {{ value.color }}"
                   :class="selectedOption === '{{ value.id }}' ? 'border-white shadow-lg' : 'border-white/10'">
                <input type="radio" name="options[{{ option.id }}]" value="{{ value.id }}" class="sr-only"/>
            </label>
        {% endfor %}
    </div>
{% elseif option.type == "single_option" %}
    <div class="flex flex-wrap gap-2">
        {% for value in option.values %}
            <label class="flex items-center justify-center px-4 py-2 rounded-xl border transition-all cursor-pointer text-sm hover:border-neon-purple/30 bg-white/[0.02] border-white/[0.08] text-white/60">
                <input type="radio" name="options[{{ option.id }}]" value="{{ value.id }}" class="sr-only"/>
                {{ value.name }}
            </label>
        {% endfor %}
    </div>
{% else %}
    {{ option.element(product.id)|raw }}
{% endif %}
