<div class="product-card-glass group">
    <a href="{{ product.url }}">
        <div class="product-image-wrapper">
            <img src="{{ product.image.url|default(product.image) }}"
                 alt="{{ product.image.alt|default(product.name) }}"
                 class="w-full h-full object-cover"
                 loading="lazy"/>

            {% if product.on_sale %}
                <div class="absolute top-3 left-3">
                    <span class="badge badge-sale">{{ trans('common.elements.sale') }}</span>
                </div>
            {% endif %}

            {% if product.promotion_title %}
                <div class="absolute top-3 right-3">
                    <span class="badge badge-new">{{ product.promotion_title }}</span>
                </div>
            {% endif %}

            <div class="quick-actions">
                <button class="quick-action-btn" title="{{ trans('common.elements.wishlist') }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                </button>
                <button class="quick-action-btn" title="{{ trans('common.elements.quick_view') }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                </button>
                <salla-add-product-button product-id="{{ product.id }}"
                                          product-status="{{ product.status }}"
                                          product-type="{{ product.type }}"
                                          class="quick-action-btn">
                </salla-add-product-button>
            </div>
        </div>
    </a>

    <div class="p-4">
        {% if product.brand %}
            <p class="text-neon-purple/60 text-xs font-medium mb-1">{{ product.brand.name }}</p>
        {% endif %}

        <a href="{{ product.url }}" class="block">
            <h3 class="text-white font-semibold text-sm md:text-base leading-tight group-hover:text-neon-purple transition-colors line-clamp-2">
                {{ product.name }}
            </h3>
        </a>

        {% if product.subtitle %}
            <p class="text-white/30 text-xs mt-1 line-clamp-1">{{ product.subtitle }}</p>
        {% endif %}

        <div class="flex items-center gap-2 mt-3">
            {% if product.on_sale %}
                <span class="text-neon-pink font-bold text-base md:text-lg">{{ product.sale_price|money }}</span>
                <span class="text-white/25 line-through text-xs">{{ product.regular_price|money }}</span>
            {% else %}
                <span class="text-white font-bold text-base md:text-lg">{{ product.price|money }}</span>
            {% endif %}
        </div>

        {% if product.rating %}
            <div class="flex items-center gap-1 mt-2">
                <div class="flex text-yellow-400 text-xs">
                    {% for i in 1..5 %}
                        <svg class="w-3 h-3 {{ i <= product.rating ? 'fill-current' : 'fill-none stroke-current text-white/20' }}"
                             viewBox="0 0 24 24">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                    {% endfor %}
                </div>
                <span class="text-white/30 text-[10px]">({{ product.total_reviews|default(0) }})</span>
            </div>
        {% endif %}
    </div>
</div>
