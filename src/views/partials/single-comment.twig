<div class="p-6">
    <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-neon-purple to-purple-700 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
            {{ comment.user.name|slice(0, 1) }}
        </div>
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="text-white font-medium text-sm">{{ comment.user.name }}</span>
                <span class="text-white/20 text-xs">{{ comment.created_at }}</span>
            </div>
            <p class="text-white/50 text-sm leading-relaxed">{{ comment.content }}</p>
        </div>
    </div>
</div>
